        <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
      </visual>
      <collision name="kitchen_counter_collision">
        <pose>-3.650 -1.750 0.450 0 0 0</pose>
