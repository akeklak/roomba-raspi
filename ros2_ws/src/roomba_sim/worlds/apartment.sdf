        <pose>-2.400 1.200 0.430 0 0 0</pose>
        <geometry><box><size>1.000 0.550 0.030</size></box></geometry>
      </collision>
      <visual name="coffee_table_top_visual">
        <pose>-2.400 1.200 0.430 0 0 0</pose>
        <geometry><box><size>1.000 0.550 0.030</size></box></geometry>
        <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
      </visual>
      <collision name="dining_table_top_collision">
        <pose>-0.300 -1.800 0.740 0 0 0</pose>
        <geometry><box><size>1.200 0.800 0.030</size></box></geometry>
      </collision>
      <visual name="dining_table_top_visual">
        <pose>-0.300 -1.800 0.740 0 0 0</pose>
        <geometry><box><size>1.200 0.800 0.030</size></box></geometry>
        <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
      </visual>
      <collision name="dock_collision">
        <pose>-3.900 0.000 0.050 0 0 0</pose>
        <geometry><box><size>0.100 0.300 0.100</size></box></geometry>
      </collision>
      <visual name="dock_visual">
        <pose>-3.900 0.000 0.050 0 0 0</pose>
