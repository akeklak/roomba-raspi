<?xml version="1.0"?>
<!--
  Simple two-room apartment with a kitchen, about 8 m x 6 m, for developing mapping, navigation
  and coverage without hardware. Generated by a one-off script; edit freely.

  Things in here on purpose: doorways (about 0.9 m), table legs the lidar sees as dots while the
  table tops sit above the lidar, a bed and couch flush to the floor, and a dock (green block)
  against the west wall. The robot spawns just east of the dock, facing east.
-->
<sdf version="1.9">
  <world name="apartment">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>
    <light type="point" name="ceiling_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2.4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="apartment">
      <static>true</static>
      <link name="link">
      <collision name="wall_north_collision">
        <pose>0.000 3.000 0.250 0 0 0</pose>
        <geometry><box><size>8.100 0.100 0.500</size></box></geometry>
      </collision>
      <visual name="wall_north_visual">
        <pose>0.000 3.000 0.250 0 0 0</pose>
        <geometry><box><size>8.100 0.100 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="wall_south_collision">
        <pose>0.000 -3.000 0.250 0 0 0</pose>
        <geometry><box><size>8.100 0.100 0.500</size></box></geometry>
      </collision>
      <visual name="wall_south_visual">
        <pose>0.000 -3.000 0.250 0 0 0</pose>
        <geometry><box><size>8.100 0.100 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="wall_west_collision">
        <pose>-4.000 0.000 0.250 0 0 0</pose>
        <geometry><box><size>0.100 6.000 0.500</size></box></geometry>
      </collision>
      <visual name="wall_west_visual">
        <pose>-4.000 0.000 0.250 0 0 0</pose>
        <geometry><box><size>0.100 6.000 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="wall_east_collision">
        <pose>4.000 0.000 0.250 0 0 0</pose>
        <geometry><box><size>0.100 6.000 0.500</size></box></geometry>
      </collision>
      <visual name="wall_east_visual">
        <pose>4.000 0.000 0.250 0 0 0</pose>
        <geometry><box><size>0.100 6.000 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="bedroom_wall_a_collision">
        <pose>1.000 -1.400 0.250 0 0 0</pose>
        <geometry><box><size>0.100 3.200 0.500</size></box></geometry>
      </collision>
      <visual name="bedroom_wall_a_visual">
        <pose>1.000 -1.400 0.250 0 0 0</pose>
        <geometry><box><size>0.100 3.200 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
