        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="kitchen_wall_a_collision">
        <pose>-3.100 -0.500 0.250 0 0 0</pose>
        <geometry><box><size>1.800 0.100 0.500</size></box></geometry>
      </collision>
      <visual name="kitchen_wall_a_visual">
        <pose>-3.100 -0.500 0.250 0 0 0</pose>
        <geometry><box><size>1.800 0.100 0.500</size></box></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
      </visual>
      <collision name="kitchen_wall_b_collision">
        <pose>-0.150 -0.500 0.250 0 0 0</pose>
        <geometry><box><size>2.300 0.100 0.500</size></box></geometry>
      </collision>
