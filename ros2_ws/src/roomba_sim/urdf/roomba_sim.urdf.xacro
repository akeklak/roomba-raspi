<?xml version="1.0"?>
<!--
  Simulated Roomba 675 + Pi for Gazebo Harmonic.

  Same frame names and topics as the real robot (roomba_bringup), so everything above the
  drivers runs unchanged:
    /cmd_vel in, /odom, /tf (odom -> base_footprint), /joint_states, /scan,
    /camera/image_raw and /camera/camera_info out.
  Geometry is plain shapes (no meshes) so Foxglove can draw it without extra files.
  Dimensions follow the Roomba 600 / Create 2: 0.34 m across, wheels 0.235 m apart, 72 mm wheels.
-->
<robot name="roomba_sim" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="body_radius" value="0.17" />
  <xacro:property name="body_height" value="0.07" />
  <xacro:property name="body_mass" value="3.5" />
  <xacro:property name="ground_clearance" value="0.01" />
  <xacro:property name="wheel_radius" value="0.036" />
  <xacro:property name="wheel_width" value="0.02" />
  <xacro:property name="wheel_separation" value="0.235" />
  <xacro:property name="caster_radius" value="0.012" />

  <!-- Sensors, matching the placeholders in roomba_bringup/urdf/roomba.urdf.xacro.
       Heights are above the floor. -->
  <xacro:property name="lidar_x" value="-0.02" />
  <xacro:property name="lidar_height" value="0.13" />
  <xacro:property name="camera_x" value="0.15" />
  <xacro:property name="camera_height" value="0.09" />
  <xacro:property name="camera_pitch" value="0.35" />
  <!-- Wide-angle camera standing in for the fisheye lens (about 140 degrees). -->
  <xacro:property name="camera_hfov" value="2.4" />

  <material name="body_grey"><color rgba="0.25 0.25 0.27 1" /></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1" /></material>
  <material name="lidar_blue"><color rgba="0.15 0.35 0.75 1" /></material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}" />
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0" iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}" />
  </xacro:macro>

  <!-- base_footprint sits on the floor under the centre of the wheels. -->
  <link name="base_footprint" />

  <!-- base_link sits at wheel-axle height. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${ground_clearance + body_height/2 - wheel_radius}" />
      <geometry><cylinder radius="${body_radius}" length="${body_height}" /></geometry>
      <material name="body_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + body_height/2 - wheel_radius}" />
      <geometry><cylinder radius="${body_radius}" length="${body_height}" /></geometry>
    </collision>
    <!-- Lidar puck on top, for looks only. -->
    <visual>
      <origin xyz="${lidar_x} 0 ${lidar_height - 0.015 - wheel_radius}" />
      <geometry><cylinder radius="0.03" length="0.03" /></geometry>
      <material name="lidar_blue" />
    </visual>
    <inertial>
      <origin xyz="0 0 ${ground_clearance + body_height/2 - wheel_radius}" />
      <mass value="${body_mass}" />
      <xacro:cylinder_inertia m="${body_mass}" r="${body_radius}" h="${body_height}" />
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
        <material name="wheel_black" />
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0" />
        <mass value="0.1" />
        <xacro:cylinder_inertia m="0.1" r="${wheel_radius}" h="${wheel_width}" />
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${side}_wheel_link" />
      <origin xyz="0 ${y} 0" />
      <axis xyz="0 1 0" />
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation/2}" />
  <xacro:wheel side="right" y="${-wheel_separation/2}" />

  <!-- Frictionless front and rear sliders keep the body level. -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <collision><geometry><sphere radius="${caster_radius}" /></geometry></collision>
      <inertial>
        <mass value="0.02" />
        <xacro:sphere_inertia m="0.02" r="${caster_radius}" />
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${name}_caster_link" />
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}" />
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.13" />
  <xacro:caster name="rear" x="-0.13" />

  <!-- Sensor frames (same names as the real robot). -->
  <link name="ldlidar_link" />
  <joint name="ldlidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="ldlidar_link" />
    <origin xyz="${lidar_x} 0 ${lidar_height - wheel_radius}" />
  </joint>

  <link name="camera_link" />
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="${camera_x} 0 ${camera_height - wheel_radius}" rpy="0 ${camera_pitch} 0" />
  </joint>

  <link name="camera_optical_link" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- Gazebo: differential drive, joint states, lidar, camera. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- The Roomba Open Interface caps wheel speed at 0.5 m/s. -->
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <!-- Where the robot really is in the world (no wheel slip), for ground_truth_localizer. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <gazebo reference="ldlidar_link">
    <sensor name="ld19" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>ldlidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- Same fixed beam count as the real driver config. -->
            <samples>455</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
