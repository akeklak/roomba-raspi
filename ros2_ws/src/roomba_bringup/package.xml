<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roomba_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, configuration, robot model and safety nodes for the Roomba 675 + Raspberry Pi 4 robot.</description>
  <maintainer email="noreply@example.com">Alexander Keklak</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>create_msgs</exec_depend>
  <exec_depend>create_driver</exec_depend>
  <exec_depend>create_description</exec_depend>
  <exec_depend>ldlidar_component</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
